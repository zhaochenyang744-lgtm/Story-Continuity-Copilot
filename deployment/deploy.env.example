PUBLIC_HOST=
CONTINUITY_BASE_URL=
CONTINUITY_INPUT_CNY_PER_MILLION=
CONTINUITY_OUTPUT_CNY_PER_MILLION=
# Writing assistant (v1.8.0): off | allowlist | registered | all. allowlist reads CONTINUITY_ASSISTANT_ALLOWLIST (account names, comma-separated).
CONTINUITY_ASSISTANT_ROLLOUT=all
CONTINUITY_ASSISTANT_ALLOWLIST=
# Model per assistant role (v2.1). Leave a line commented out (or empty) and that role uses CONTINUITY_ASSISTANT_MODEL, and without
# that, CONTINUITY_MODEL. loop = the main loop (ask, recap, fix, change); route = the input box's judgement; requests = splitting a
# change sentence into requests; plan = planning for long tasks (not used yet). A role's own model must be on the provider's base URL.
# compose.yaml does not pass these (nor CONTINUITY_ASSISTANT_MODEL) into the container yet: the server runs every role on its
# CONTINUITY_MODEL until a role's line is added to compose's environment, which is done when a role ships with its own model.
# CONTINUITY_MODEL_LOOP=
# CONTINUITY_MODEL_ROUTE=
# CONTINUITY_MODEL_REQUESTS=
# CONTINUITY_MODEL_PLAN=
VISITOR_ASSISTANT_TASKS_24H=3
ASSISTANT_TASK_MAX_CNY=0.30
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SCC_SECRET_DIR=/etc/story-continuity/secrets

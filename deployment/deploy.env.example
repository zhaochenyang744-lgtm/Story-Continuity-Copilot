PUBLIC_HOST=
CONTINUITY_BASE_URL=
CONTINUITY_INPUT_CNY_PER_MILLION=
CONTINUITY_OUTPUT_CNY_PER_MILLION=
# Writing assistant (v1.8.0): off | allowlist | registered | all. allowlist reads CONTINUITY_ASSISTANT_ALLOWLIST (account names, comma-separated).
CONTINUITY_ASSISTANT_ROLLOUT=all
CONTINUITY_ASSISTANT_ALLOWLIST=
VISITOR_ASSISTANT_TASKS_24H=3
ASSISTANT_TASK_MAX_CNY=0.30
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SCC_SECRET_DIR=/etc/story-continuity/secrets

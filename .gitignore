# Secrets and local runtime
.env
.env.*
!.env.example
runtime/
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Python environments, caches, and test output
.venv/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
coverage/

# Node and browser-test output
frontend/node_modules/
frontend/.next/
frontend/.next-*/
frontend/out/
frontend/playwright-report/
frontend/test-results/
frontend/.env.local
*.tsbuildinfo

# Local evaluation cache.
evaluation/.cache/

# Local runner output, logs and audit products are never versioned.
artifacts/*

# A1/A1b runner scratch: resumable checkpoints, per-run copies, local project workspaces and the run lock.
evaluation/results/*-checkpoint*.json
evaluation/results/*-report-run-*.json
evaluation/results/*.workspaces/
evaluation/results/*.lock

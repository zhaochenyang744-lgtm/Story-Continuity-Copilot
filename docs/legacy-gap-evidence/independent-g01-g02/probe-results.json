          }
        ],
        "source_spans": [
          {
            "body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
            "chapter_id": "ch-b4fc21d6-de23-4ba6-9c47-c9dbb8752edb",
            "chapter_number": 4,
            "chapter_title": "无字潮表",
            "id": "span-3970699a-da46-46f1-9947-fabf2d7ba349",
            "label": "知识边界",
            "source_revision": 1
          },
          {
            "body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
            "chapter_id": "ch-00117c1f-2e7f-47cb-902d-a0aea30f961f",
            "chapter_number": 8,
            "chapter_title": "北堤灯火",

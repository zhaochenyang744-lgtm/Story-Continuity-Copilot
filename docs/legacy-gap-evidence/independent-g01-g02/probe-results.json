        "source_spans": [
          {
            "body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
            "chapter_id": "ch-170119bf-db96-44ff-9474-0ecb811b7a1e",
            "chapter_number": 7,
            "chapter_title": "潮线之外",
            "id": "span-1956ef95-ecfa-4297-a0d7-1196d8dc0598",
            "label": "地点状态",
            "source_revision": 1
          },
          {
            "body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
            "chapter_id": "ch-86c612d1-2cff-48f3-9668-1acd0330d369",
            "chapter_number": 6,
            "chapter_title": "低室电台",
            "id": "span-5d03a0f0-9e7d-4b11-a45d-d723e9e60e44",
            "label": "事件记录",
            "source_revision": 1
          },
          {
            "body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
            "chapter_id": "ch-0257d17d-60d6-49de-bafc-f8f8827b15e9",
            "chapter_number": 10,
            "chapter_title": "回声坐标",
            "id": "span-8bb85bab-37d1-4616-9aa0-04e0bfb038d8",
            "label": "未解问题",
            "source_revision": 1
          },
          {
            "body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
            "chapter_id": "ch-da15b2a9-502a-4697-b1b1-5f5a30e00053",
            "chapter_number": 9,
            "chapter_title": "换手",
            "id": "span-67d8ea64-9f0d-4f55-aea0-a71d66f67254",
            "label": "动态状态",
            "source_revision": 1
          }
        ]

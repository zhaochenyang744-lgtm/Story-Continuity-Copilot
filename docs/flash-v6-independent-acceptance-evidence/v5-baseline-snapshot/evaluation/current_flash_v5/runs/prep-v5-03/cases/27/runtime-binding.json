  "draft_body_sha256": "2005fb472e4d473c2fd327b19ab6d3b5df281af7fb806ce2216b2498f2a23269",
  "source_revision": 1,
  "memory_version": 4,
  "chapters": [
    {
      "chapter_id": "ch-6caeb23b-5691-42b6-8283-72c2aaebb7e6",
      "chapter_number": 1,
      "chapter_title": "雾钟",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-4fa3871a-72fe-46db-9df2-830ac890cf86",
      "span_body": "灰港的雾钟只在北潮闸完全关闭后敲响一次，别的潮声不会让它响。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "94ba09a3cf9e29cb6a363a03322de398f60a9af31d2a89b50a916f392ec5e12e"
    },
    {
      "chapter_id": "ch-c4e2034c-cee9-475f-b8d3-d05237c989ae",
      "chapter_number": 2,
      "chapter_title": "裂纹罗盘",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-281c4f0c-0555-4a22-9803-7d9d88faa788",
      "span_body": "黄铜罗盘的镜面有一道月牙裂纹，此刻由苏岑放在外套内袋。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "68dacbc00263341e60fdeb68f264492dc0953140827d264994dcd12e9a26b422"
    },
    {
      "chapter_id": "ch-3a3b141e-005e-4ee4-a13c-4aed1f5cc256",
      "chapter_number": 3,
      "chapter_title": "迟到的渡船",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-20918a6c-c1ef-4828-ae51-3aa278c118c5",
      "span_body": "十九点二十，西航道先退潮，最后一班渡船在十九点四十才离开风栈码头。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "bfc55c345ab2ca0d5d343ea3733b01bf801a9aac8b040685f711076b08bd8b03"
    },
    {
      "chapter_id": "ch-3d868738-acb7-410b-be22-70a7b8229f43",
      "chapter_number": 4,
      "chapter_title": "无字潮表",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-4321e5e9-b5ed-47fc-bb41-83e24945f56d",
      "span_body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "2b42960d67fb622a2484050f9afe31dea302dd059c7dda3cf0d31eab4a70bbd3"
    },
    {
      "chapter_id": "ch-7017c822-bb37-4972-bd2f-0749563b8535",
      "chapter_number": 5,
      "chapter_title": "盐雾信箱",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-d2a26b0d-8d0a-4ff8-81a2-d1b66a3873a8",
      "span_body": "纸条只写着‘白色渡船没有靠岸’，署名和日期都被盐雾抹去了。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8a0f8a53b219be663bc27b02decd36f0f5600f1e703c9b71f82dae2b4b3f1387"
    },
    {
      "chapter_id": "ch-f30bb2a4-1a4a-431b-99d6-dabca5e1eee5",
      "chapter_number": 6,
      "chapter_title": "低室电台",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-3c5e10d5-6648-48cf-9345-df192f000a27",
      "span_body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8cfce58f0ce8de9ee07de1a3123b29e091c5b1917928caf4f6a90dfc79f04c3e"
    },
    {
      "chapter_id": "ch-c3fa2162-fd91-491e-9a02-211eb7c7fe98",
      "chapter_number": 7,
      "chapter_title": "潮线之外",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-aaef752c-fc6f-4d18-80b5-26d5e1d18e11",
      "span_body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "82d77670ec3f945f5da30dd608e7accd6640a3f09bf103c54114bcf52141e1ff"
    },
    {
      "chapter_id": "ch-ef51b8dd-d0de-4cc9-bbbd-447c2fa822f1",
      "chapter_number": 8,
      "chapter_title": "北堤灯火",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-8122b44b-1f43-4e45-ae0a-30622f10364c",
      "span_body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "ab75da7e0d3ec24955927e77a13bcf72efac68cf8d8d7d84922e5f0cbfb6dbcd"
    },
    {
      "chapter_id": "ch-c9637c70-0f85-4afb-8174-5d42aa61867f",
      "chapter_number": 9,
      "chapter_title": "换手",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-ed69ce8a-1a83-4fb8-987b-3bbfbea8e15f",
      "span_body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b07ea48fcdc8ed1f76041a0cd9188055ec40adeef4a969b63b212357bef229dd"
    },
    {
      "chapter_id": "ch-4019854e-1a33-4eb0-a7b9-1221dc3a7af9",
      "chapter_number": 10,
      "chapter_title": "回声坐标",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-6414d0c7-6fc8-4fc2-8591-88107d978653",
      "span_body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b3265433a0a1022e4d049a4768879f6763f8db0dbca1c858802e228639ea3e6c"
    }
  ],

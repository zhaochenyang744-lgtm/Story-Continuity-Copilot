            "source_spans": [
              {
                "body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
                "chapter_id": "ch-436d743c-6829-49bf-8474-ace984896c01",
                "chapter_number": 7,
                "chapter_title": "潮线之外",
                "id": "span-690d278c-3c8c-4a5f-b15d-159a163c54ab",
                "label": "地点状态",
                "source_revision": 1
              },
              {
                "body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
                "chapter_id": "ch-3d5718e0-5900-4ec1-adaf-3798f1e2af53",
                "chapter_number": 6,
                "chapter_title": "低室电台",
                "id": "span-648cbc8b-f4d4-447d-a2e6-76f933f81f83",
                "label": "事件记录",
                "source_revision": 1
              },
              {
                "body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
                "chapter_id": "ch-6304bb65-75e2-4869-8ee9-6be9ec491d67",
                "chapter_number": 10,
                "chapter_title": "回声坐标",
                "id": "span-01cbc73f-5d53-422b-a12c-c97a8bbabb96",
                "label": "未解问题",
                "source_revision": 1
              },
              {
                "body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
                "chapter_id": "ch-9368f59a-563e-4450-aa73-e6e86e748c0a",
                "chapter_number": 9,
                "chapter_title": "换手",
                "id": "span-55276647-9c63-49b7-aa50-064e397e7e60",
                "label": "动态状态",
                "source_revision": 1
              }
            ]
          }

  "business_request_sha256": "5a1493abef89e9d8a7cf8d01d7c6ad32eb2085d6e800b29a8d61af00196635c3",
  "bindings": {
    "author_context_snapshot_digest": "4dd96473e0c0674dceb1dd5ccd73902d871d93c8cdab8f45614f64535cd434b0",
    "author_context_version": 0,
    "draft_id": "draft-720faa70-dfa4-4c24-a343-5010a04949fb",
    "draft_revision": 2,
    "memory_version": 4,
    "project_id": "prj-6a8edc23-281c-41e0-8cea-4cf360417e82",
    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-720faa70-dfa4-4c24-a343-5010a04949fb-r2-1",
      "text": "陈澈说：‘温岚已经把潮汐表交给林默。’",
      "sha256": "01c8159c096f92feba33562657a1769e5c9a21dbf09714c3d4783e6f96f3f2bb"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-720faa70-dfa4-4c24-a343-5010a04949fb-r2-2",
      "text": "温岚摇头说：‘我没有交出潮汐表，它仍在我的背包里。’",
      "sha256": "30e952c74e874737b0fd95eb3fb9ffa7222dbf4763f5ef24e853a3903ff97143"
    },
    {
      "kind": "source_span",
      "id": "span-1a868c8c-46e5-434f-a84a-1350394339b6",
      "chapter_id": "ch-da215663-cc2a-4cd3-bf6d-a9a6556c473f",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "source_span",
      "id": "span-33e69ebe-f248-4682-bfd5-1e809c03839d",
      "chapter_id": "ch-a1a034a2-92f8-438d-ac37-1fa6ad50b8e0",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "source_span",
      "id": "span-95f22065-f4aa-44b2-9a9d-d3d61fcb761b",
      "chapter_id": "ch-499a0fc1-2062-4405-bd15-20afd916cc91",
      "chapter_number": 9,
      "source_revision": 1,
      "text": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "sha256": "c118f3d296dfb8d143c3b0b5467637a24e73f833356f845d5d5c7596956d88a5"
    },
    {
      "kind": "source_span",
      "id": "span-5e0e1450-eff0-4f20-baac-893683439e83",
      "chapter_id": "ch-eaa7d0be-9f4d-424d-a16c-c1f302d32f3d",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "memory_record",
      "id": "mem-071389d2-1f4d-46d3-b885-49d358a669f9",
      "source_span_id": "span-dc10ea8d-a720-4aea-a6bc-a230d155101b",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-1a214967-be0e-426e-9a17-68dd4199a614",
      "source_span_id": "span-1cff79ef-0135-4b43-83c7-7374b0caa429",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-cf787710-41b0-45ae-8148-956e513cf6a5",
      "source_span_id": "span-95f22065-f4aa-44b2-9a9d-d3d61fcb761b",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-5a21d974-76fd-4aee-90ad-e179adb38726",
      "source_span_id": "span-ddd502ff-8322-4f7b-ad18-5c4a868cc16e",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    },
    {
      "kind": "memory_record",
      "id": "mem-8828a1a8-4520-425f-ad09-2a8515b936c8",
      "source_span_id": "span-5e0e1450-eff0-4f20-baac-893683439e83",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-94a69a02-e25e-4af6-b082-893dae75325b",
      "source_span_id": "span-c0238711-abe2-4d2a-b9a9-b61fdb21c4dd",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-b719bf4b-cb6a-4192-ba05-8b9d8f0790b1",
      "source_span_id": "span-9bd44b44-34cd-4161-8ce7-80013e417f07",
      "text": "雾线水门外锚柱",
      "sha256": "364a41b7ccb226b487b22c1ca8c19df403c7d951678a34979003acf57e4a072e"
    },
    {
      "kind": "memory_record",
      "id": "mem-c1298f9e-3ad1-441b-a6a0-4310307e5d69",
      "source_span_id": "span-33e69ebe-f248-4682-bfd5-1e809c03839d",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    }
  ],

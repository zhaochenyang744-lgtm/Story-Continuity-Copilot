{
  "project_id": "prj-6a8edc23-281c-41e0-8cea-4cf360417e82",
  "draft_id": "draft-720faa70-dfa4-4c24-a343-5010a04949fb",
  "draft_revision": 2,
  "draft_body": "陈澈说：‘温岚已经把潮汐表交给林默。’温岚摇头说：‘我没有交出潮汐表，它仍在我的背包里。’",
  "draft_body_sha256": "efbd2767a8328cd339f26b4983e8ac5bfa56e02842dd14b5e1e1c18db629ed17",
  "source_revision": 1,
  "memory_version": 4,
  "chapters": [
    {
      "chapter_id": "ch-6376f0cf-ec48-45f8-852c-ed434d9f3114",
      "chapter_number": 1,
      "chapter_title": "雾钟",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-ddd502ff-8322-4f7b-ad18-5c4a868cc16e",
      "span_body": "灰港的雾钟只在北潮闸完全关闭后敲响一次，别的潮声不会让它响。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "94ba09a3cf9e29cb6a363a03322de398f60a9af31d2a89b50a916f392ec5e12e"
    },
    {
      "chapter_id": "ch-63516c24-f171-44a0-a904-1ded24b8942e",
      "chapter_number": 2,
      "chapter_title": "裂纹罗盘",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-25feef2c-30bc-49a0-bc2d-baeae61101ed",
      "span_body": "黄铜罗盘的镜面有一道月牙裂纹，此刻由苏岑放在外套内袋。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "68dacbc00263341e60fdeb68f264492dc0953140827d264994dcd12e9a26b422"
    },
    {
      "chapter_id": "ch-548d66c3-ffdb-4326-8a54-81bd65ba8e06",
      "chapter_number": 3,
      "chapter_title": "迟到的渡船",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-c0238711-abe2-4d2a-b9a9-b61fdb21c4dd",
      "span_body": "十九点二十，西航道先退潮，最后一班渡船在十九点四十才离开风栈码头。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "bfc55c345ab2ca0d5d343ea3733b01bf801a9aac8b040685f711076b08bd8b03"
    },
    {
      "chapter_id": "ch-d0440c72-13b7-4b8f-bef0-6395232c69ce",
      "chapter_number": 4,
      "chapter_title": "无字潮表",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-1cff79ef-0135-4b43-83c7-7374b0caa429",
      "span_body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "2b42960d67fb622a2484050f9afe31dea302dd059c7dda3cf0d31eab4a70bbd3"
    },
    {
      "chapter_id": "ch-a4790876-abe2-4402-944c-d7055d499c19",
      "chapter_number": 5,
      "chapter_title": "盐雾信箱",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-dc10ea8d-a720-4aea-a6bc-a230d155101b",
      "span_body": "纸条只写着‘白色渡船没有靠岸’，署名和日期都被盐雾抹去了。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8a0f8a53b219be663bc27b02decd36f0f5600f1e703c9b71f82dae2b4b3f1387"
    },
    {
      "chapter_id": "ch-eaa7d0be-9f4d-424d-a16c-c1f302d32f3d",
      "chapter_number": 6,
      "chapter_title": "低室电台",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-5e0e1450-eff0-4f20-baac-893683439e83",
      "span_body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8cfce58f0ce8de9ee07de1a3123b29e091c5b1917928caf4f6a90dfc79f04c3e"
    },
    {
      "chapter_id": "ch-1d78fc8d-65c1-426a-b1fe-bcec18cb0e86",
      "chapter_number": 7,
      "chapter_title": "潮线之外",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-9bd44b44-34cd-4161-8ce7-80013e417f07",
      "span_body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "82d77670ec3f945f5da30dd608e7accd6640a3f09bf103c54114bcf52141e1ff"
    },
    {
      "chapter_id": "ch-da215663-cc2a-4cd3-bf6d-a9a6556c473f",
      "chapter_number": 8,
      "chapter_title": "北堤灯火",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-1a868c8c-46e5-434f-a84a-1350394339b6",
      "span_body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "ab75da7e0d3ec24955927e77a13bcf72efac68cf8d8d7d84922e5f0cbfb6dbcd"
    },
    {
      "chapter_id": "ch-499a0fc1-2062-4405-bd15-20afd916cc91",
      "chapter_number": 9,
      "chapter_title": "换手",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-95f22065-f4aa-44b2-9a9d-d3d61fcb761b",
      "span_body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b07ea48fcdc8ed1f76041a0cd9188055ec40adeef4a969b63b212357bef229dd"
    },
    {
      "chapter_id": "ch-a1a034a2-92f8-438d-ac37-1fa6ad50b8e0",
      "chapter_number": 10,
      "chapter_title": "回声坐标",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-33e69ebe-f248-4682-bfd5-1e809c03839d",
      "span_body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b3265433a0a1022e4d049a4768879f6763f8db0dbca1c858802e228639ea3e6c"
    }
  ],

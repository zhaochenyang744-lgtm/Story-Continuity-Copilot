  "business_request_sha256": "72630335e64a6d122e65b2d60a879efe7fea7bdd20701e7d587612bdfd2f0086",
  "bindings": {
    "author_context_snapshot_digest": "4dd96473e0c0674dceb1dd5ccd73902d871d93c8cdab8f45614f64535cd434b0",
    "author_context_version": 0,
    "draft_id": "draft-f546f392-553e-4908-9f0e-32fb4f79052b",
    "draft_revision": 2,
    "memory_version": 4,
    "project_id": "prj-72c880f1-e5b3-4e52-a46b-1ce006d40bde",
    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-f546f392-553e-4908-9f0e-32fb4f79052b-r2-1",
      "text": "林默走进北门。",
      "sha256": "e4176f286a3ddb9f942263869e400c8c74ea13a68e2dbcbe3ed73505c7823393"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-f546f392-553e-4908-9f0e-32fb4f79052b-r2-2",
      "text": "银钥匙已经交给陈澈。",
      "sha256": "e0a1e5eee3175170025956d235e62111588b69ab9ff2e11e50dba98c31f013d3"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-f546f392-553e-4908-9f0e-32fb4f79052b-r2-3",
      "text": "她此时已经知道弟弟还活着。",
      "sha256": "68c58cfebe353b336151d8195db179a24c5b3b24f38a633a3003dd4cd488ca01"
    },
    {
      "kind": "source_span",
      "id": "span-e88683a3-a9ce-47ca-9f7f-0507e0547219",
      "chapter_id": "ch-c5f3c0be-0f41-47fc-85a9-ab02e9e3bb7c",
      "chapter_number": 4,
      "source_revision": 1,
      "text": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "sha256": "acdbf3c6f280f8ce238bfd95fffc9f29461689cbd936b4002c519c4f303b5657"
    },
    {
      "kind": "source_span",
      "id": "span-3ce58396-ae48-433e-8112-243b79f05a16",
      "chapter_id": "ch-81256c83-74c3-462b-b94c-d09c3bfb28fb",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "source_span",
      "id": "span-b7a883d4-f40a-4f54-97eb-9061ad0e6694",
      "chapter_id": "ch-13efe41a-5ce7-4863-9102-d787544795a4",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "source_span",
      "id": "span-cde21f23-d9eb-479b-af46-2c873ccd4cad",
      "chapter_id": "ch-ae692ab7-ecd2-4354-9ae4-cba96dc98f06",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "memory_record",
      "id": "mem-ea6a6e39-5451-4062-9b49-04baa995b04a",
      "source_span_id": "span-e88683a3-a9ce-47ca-9f7f-0507e0547219",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-1bae8ca8-8c8f-4fdc-9025-3b52ed60c022",
      "source_span_id": "span-5d3ae877-5f09-4c40-a076-7c4330f95983",
      "text": "雾线水门外锚柱",
      "sha256": "364a41b7ccb226b487b22c1ca8c19df403c7d951678a34979003acf57e4a072e"
    },
    {
      "kind": "memory_record",
      "id": "mem-271773fa-eb6c-4ba3-8645-d3f47c15027e",
      "source_span_id": "span-5bcec869-f37e-4033-b92b-d20fe19887b4",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-2a0fbf9a-d8c0-4d42-925f-ef98fb415962",
      "source_span_id": "span-8d1bdd8f-b320-4e00-93f2-c3137025b8a6",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-5aecb1c7-6309-417d-be1a-0671d794c1fc",
      "source_span_id": "span-cde21f23-d9eb-479b-af46-2c873ccd4cad",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-a93b340f-3f8e-44e4-89c7-91ef8401d4ca",
      "source_span_id": "span-b7a883d4-f40a-4f54-97eb-9061ad0e6694",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-aff6a46f-1198-4253-a8bb-c2cbb961ce50",
      "source_span_id": "span-f74faf28-9001-44ba-b501-bd63b3a3486e",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    },
    {
      "kind": "memory_record",
      "id": "mem-ccb0d23e-6ab5-4727-a8ef-c1efcb2c25ef",

{
  "project_id": "prj-715ca3b2-9900-48fc-b05a-7769e2fba4fc",
  "draft_id": "draft-432b11b1-c704-4170-a352-446cb6064878",
  "draft_revision": 2,
  "draft_body": "林默走进北门。林默走进北门。",
  "draft_body_sha256": "3e296b4f2262e0655b7a88d79bc09fdb99b25b1720d6c3533ebf1df0a3125223",
  "source_revision": 1,
  "memory_version": 4,
  "chapters": [
    {
      "chapter_id": "ch-df46df71-db08-423b-8a91-70dac23a7cca",
      "chapter_number": 1,
      "chapter_title": "雾钟",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-c9733130-5e16-429b-bf0d-3b17912a0135",
      "span_body": "灰港的雾钟只在北潮闸完全关闭后敲响一次，别的潮声不会让它响。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "94ba09a3cf9e29cb6a363a03322de398f60a9af31d2a89b50a916f392ec5e12e"
    },
    {
      "chapter_id": "ch-8e9c2cdb-8960-46cd-9977-945b67b813bd",
      "chapter_number": 2,
      "chapter_title": "裂纹罗盘",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-acf93972-08b5-400f-b271-7266bd2f5568",
      "span_body": "黄铜罗盘的镜面有一道月牙裂纹，此刻由苏岑放在外套内袋。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "68dacbc00263341e60fdeb68f264492dc0953140827d264994dcd12e9a26b422"
    },
    {
      "chapter_id": "ch-263b6cb1-035d-4cc8-8a29-8207683137e0",
      "chapter_number": 3,
      "chapter_title": "迟到的渡船",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-b31b87b9-030e-459d-bc9e-8e8c51e1025a",
      "span_body": "十九点二十，西航道先退潮，最后一班渡船在十九点四十才离开风栈码头。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "bfc55c345ab2ca0d5d343ea3733b01bf801a9aac8b040685f711076b08bd8b03"
    },
    {
      "chapter_id": "ch-35b59c02-7432-4c9f-810e-e86108fb5922",
      "chapter_number": 4,
      "chapter_title": "无字潮表",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-9f61bc08-cfc2-45e2-aa33-495ac52a781b",
      "span_body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "2b42960d67fb622a2484050f9afe31dea302dd059c7dda3cf0d31eab4a70bbd3"
    },
    {
      "chapter_id": "ch-67f467d7-952e-4d6e-ab90-aed5bd008af9",
      "chapter_number": 5,
      "chapter_title": "盐雾信箱",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-db9fd9ec-7913-4106-8faa-201d19f2c7ed",
      "span_body": "纸条只写着‘白色渡船没有靠岸’，署名和日期都被盐雾抹去了。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8a0f8a53b219be663bc27b02decd36f0f5600f1e703c9b71f82dae2b4b3f1387"
    },
    {
      "chapter_id": "ch-c3588b7b-3b49-4abd-8a6d-241a7829e72e",
      "chapter_number": 6,
      "chapter_title": "低室电台",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-62ae7d78-95f9-41d5-8297-234791dd5ca7",
      "span_body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8cfce58f0ce8de9ee07de1a3123b29e091c5b1917928caf4f6a90dfc79f04c3e"
    },
    {
      "chapter_id": "ch-ddf3a0b3-2237-4b93-bf3b-93ad37cb431a",
      "chapter_number": 7,
      "chapter_title": "潮线之外",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-c72015f2-4ca4-4b95-baed-10b85308c309",
      "span_body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "82d77670ec3f945f5da30dd608e7accd6640a3f09bf103c54114bcf52141e1ff"
    },
    {
      "chapter_id": "ch-c4e513e4-3460-4af0-9596-6fccf03a99d4",
      "chapter_number": 8,
      "chapter_title": "北堤灯火",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-51beec8f-e734-4e3f-bd17-de04b9283a84",
      "span_body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "ab75da7e0d3ec24955927e77a13bcf72efac68cf8d8d7d84922e5f0cbfb6dbcd"
    },
    {
      "chapter_id": "ch-8541970a-0ec2-46ab-bf31-39197749918c",
      "chapter_number": 9,
      "chapter_title": "换手",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-01df0d99-a5c7-4a55-883b-066c998b4f23",
      "span_body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b07ea48fcdc8ed1f76041a0cd9188055ec40adeef4a969b63b212357bef229dd"
    },
    {
      "chapter_id": "ch-41ffacf7-1c87-4a84-b493-428eac182810",
      "chapter_number": 10,
      "chapter_title": "回声坐标",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-77b2fe59-b0b0-498f-acfc-3115ae14df94",
      "span_body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b3265433a0a1022e4d049a4768879f6763f8db0dbca1c858802e228639ea3e6c"
    }
  ],

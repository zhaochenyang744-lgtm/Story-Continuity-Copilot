  "memory_version": 4,
  "chapters": [
    {
      "chapter_id": "ch-268decfb-99fb-4d7b-a218-ad1a6abe124a",
      "chapter_number": 1,
      "chapter_title": "雾钟",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-e130cfd0-72f0-41ed-b07d-70d4e0fd06f1",
      "span_body": "灰港的雾钟只在北潮闸完全关闭后敲响一次，别的潮声不会让它响。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "94ba09a3cf9e29cb6a363a03322de398f60a9af31d2a89b50a916f392ec5e12e"
    },
    {
      "chapter_id": "ch-50ea8b7f-07c3-4977-9542-83a07423491a",
      "chapter_number": 2,
      "chapter_title": "裂纹罗盘",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-a3249d1d-2be0-4c17-819f-8f555957f3fa",
      "span_body": "黄铜罗盘的镜面有一道月牙裂纹，此刻由苏岑放在外套内袋。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "68dacbc00263341e60fdeb68f264492dc0953140827d264994dcd12e9a26b422"
    },
    {
      "chapter_id": "ch-be2d811b-b70d-4c43-ac03-70d2a73b4231",
      "chapter_number": 3,
      "chapter_title": "迟到的渡船",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-60dc5ab2-9772-4f0c-b3b9-79a31b721bf7",
      "span_body": "十九点二十，西航道先退潮，最后一班渡船在十九点四十才离开风栈码头。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "bfc55c345ab2ca0d5d343ea3733b01bf801a9aac8b040685f711076b08bd8b03"
    },
    {
      "chapter_id": "ch-d6191c48-7e79-4e9e-b9e0-536ae8d4a676",
      "chapter_number": 4,
      "chapter_title": "无字潮表",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-8cd22310-fadb-4ba1-895e-fe8b5bc984f6",
      "span_body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "2b42960d67fb622a2484050f9afe31dea302dd059c7dda3cf0d31eab4a70bbd3"
    },
    {
      "chapter_id": "ch-0008c896-b1aa-401a-a347-cd2e01f1a4c2",
      "chapter_number": 5,
      "chapter_title": "盐雾信箱",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-6bc6b15f-6545-411f-baa7-3e66b94fdf54",
      "span_body": "纸条只写着‘白色渡船没有靠岸’，署名和日期都被盐雾抹去了。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8a0f8a53b219be663bc27b02decd36f0f5600f1e703c9b71f82dae2b4b3f1387"
    },
    {
      "chapter_id": "ch-b8b21b29-158f-4cba-b936-4cecda2f8722",
      "chapter_number": 6,
      "chapter_title": "低室电台",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-9a04e343-69cd-4ec5-b1be-09beea6af7c5",
      "span_body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8cfce58f0ce8de9ee07de1a3123b29e091c5b1917928caf4f6a90dfc79f04c3e"
    },
    {
      "chapter_id": "ch-48f72dbb-3891-4db7-a860-adde640a24e4",
      "chapter_number": 7,
      "chapter_title": "潮线之外",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-0f5adfa3-9f3c-4e06-a5c4-d9c85a655c14",
      "span_body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "82d77670ec3f945f5da30dd608e7accd6640a3f09bf103c54114bcf52141e1ff"
    },
    {
      "chapter_id": "ch-ca97f151-35ab-4b17-b604-a1c539017b86",
      "chapter_number": 8,
      "chapter_title": "北堤灯火",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-94fc3556-d831-4149-b2fb-ee30dc88680b",
      "span_body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "ab75da7e0d3ec24955927e77a13bcf72efac68cf8d8d7d84922e5f0cbfb6dbcd"
    },
    {
      "chapter_id": "ch-b1fc5119-0332-43d8-9565-7aacfe2da9fd",
      "chapter_number": 9,
      "chapter_title": "换手",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-6bd857e1-21ee-4054-8f11-d8e06f5fb262",
      "span_body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b07ea48fcdc8ed1f76041a0cd9188055ec40adeef4a969b63b212357bef229dd"
    },
    {
      "chapter_id": "ch-99490c63-237c-4869-a709-65b049538984",
      "chapter_number": 10,
      "chapter_title": "回声坐标",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-88a1327d-6606-4e8a-b292-f33f49959b73",
      "span_body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b3265433a0a1022e4d049a4768879f6763f8db0dbca1c858802e228639ea3e6c"
    }
  ],

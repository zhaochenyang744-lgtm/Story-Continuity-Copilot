  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-2d95667f-e19f-4e35-ac7e-ad388480d653-r2-1",
      "text": "林默走进北门。",
      "sha256": "e4176f286a3ddb9f942263869e400c8c74ea13a68e2dbcbe3ed73505c7823393"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-2d95667f-e19f-4e35-ac7e-ad388480d653-r2-2",
      "text": "林默走进北门。",
      "sha256": "e4176f286a3ddb9f942263869e400c8c74ea13a68e2dbcbe3ed73505c7823393"
    },
    {
      "kind": "source_span",
      "id": "span-c0119199-78d8-4a3e-ae94-2ca0b2b65ce6",
      "chapter_id": "ch-6954a2cf-3afc-4d97-89c1-3959283aac07",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "source_span",
      "id": "span-b2df0057-6f4a-4ca1-9619-70fc30cc23a0",
      "chapter_id": "ch-e400aa16-5a23-404e-b3b1-268edc43fb19",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "source_span",
      "id": "span-36dfc0f8-20b4-4e06-8307-5a9d93cdaa72",
      "chapter_id": "ch-0e492023-7981-40dc-8da0-1419777b9894",
      "chapter_number": 9,
      "source_revision": 1,
      "text": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "sha256": "c118f3d296dfb8d143c3b0b5467637a24e73f833356f845d5d5c7596956d88a5"
    },
    {
      "kind": "source_span",
      "id": "span-0341796b-5503-4254-9df5-8acec941fa3f",
      "chapter_id": "ch-c50239fe-72eb-495a-a948-a01c72677cb5",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "memory_record",
      "id": "mem-35f1bb4e-97bd-4f23-bbe7-7b01ba155a61",
      "source_span_id": "span-c631ab8b-bdc3-4da6-94ff-cc65dcdc54ff",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-38a62ef0-fea6-451a-aef5-f3e2654eef1d",
      "source_span_id": "span-326d3c17-fcde-4f33-ba8a-ec7d1e671e9f",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-3b658a6b-d71e-48ca-8ffb-ebeae33bcdb7",
      "source_span_id": "span-64854532-e299-4865-8648-52626c76548c",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    },
    {
      "kind": "memory_record",
      "id": "mem-3ce80124-b0b3-4823-8e4f-574885b01499",
      "source_span_id": "span-c0119199-78d8-4a3e-ae94-2ca0b2b65ce6",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-61e871df-299a-4139-8305-7170a4eba47b",
      "source_span_id": "span-b2df0057-6f4a-4ca1-9619-70fc30cc23a0",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-900e2d64-890c-4afa-a855-9b9bd7def099",
      "source_span_id": "span-f5f3e5ac-7fb3-4746-8c7c-f520269edf62",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-a0a89f62-000d-4fe7-af6a-8d2c01f280c2",
      "source_span_id": "span-36dfc0f8-20b4-4e06-8307-5a9d93cdaa72",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",

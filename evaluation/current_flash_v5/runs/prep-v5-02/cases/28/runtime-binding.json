{
  "project_id": "prj-391e8056-d017-4b4f-bb93-27e769130293",
  "draft_id": "draft-2d95667f-e19f-4e35-ac7e-ad388480d653",
  "draft_revision": 2,
  "draft_body": "林默走进北门。林默走进北门。",
  "draft_body_sha256": "3e296b4f2262e0655b7a88d79bc09fdb99b25b1720d6c3533ebf1df0a3125223",
  "source_revision": 1,
  "memory_version": 4,
  "chapters": [
    {
      "chapter_id": "ch-15575dfb-e6a9-44e8-ac56-f4c0a96b4fc6",
      "chapter_number": 1,
      "chapter_title": "雾钟",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-64854532-e299-4865-8648-52626c76548c",
      "span_body": "灰港的雾钟只在北潮闸完全关闭后敲响一次，别的潮声不会让它响。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "94ba09a3cf9e29cb6a363a03322de398f60a9af31d2a89b50a916f392ec5e12e"
    },
    {
      "chapter_id": "ch-15f4d8d6-8ed7-4dae-b3d6-25f42a002550",
      "chapter_number": 2,
      "chapter_title": "裂纹罗盘",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-ec8ef4fb-cd2b-421d-b712-955a88939b1e",
      "span_body": "黄铜罗盘的镜面有一道月牙裂纹，此刻由苏岑放在外套内袋。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "68dacbc00263341e60fdeb68f264492dc0953140827d264994dcd12e9a26b422"
    },
    {
      "chapter_id": "ch-496766f3-8553-4f85-9098-3ece7fdab697",
      "chapter_number": 3,
      "chapter_title": "迟到的渡船",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-f5f3e5ac-7fb3-4746-8c7c-f520269edf62",
      "span_body": "十九点二十，西航道先退潮，最后一班渡船在十九点四十才离开风栈码头。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "bfc55c345ab2ca0d5d343ea3733b01bf801a9aac8b040685f711076b08bd8b03"
    },
    {
      "chapter_id": "ch-0be6645d-9442-45bd-8f4d-041546d24b24",
      "chapter_number": 4,
      "chapter_title": "无字潮表",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-326d3c17-fcde-4f33-ba8a-ec7d1e671e9f",
      "span_body": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "2b42960d67fb622a2484050f9afe31dea302dd059c7dda3cf0d31eab4a70bbd3"
    },
    {
      "chapter_id": "ch-1aba29c7-bcc5-4316-a36e-71e15d69b7d3",
      "chapter_number": 5,
      "chapter_title": "盐雾信箱",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-c631ab8b-bdc3-4da6-94ff-cc65dcdc54ff",
      "span_body": "纸条只写着‘白色渡船没有靠岸’，署名和日期都被盐雾抹去了。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8a0f8a53b219be663bc27b02decd36f0f5600f1e703c9b71f82dae2b4b3f1387"
    },
    {
      "chapter_id": "ch-6954a2cf-3afc-4d97-89c1-3959283aac07",
      "chapter_number": 6,
      "chapter_title": "低室电台",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-c0119199-78d8-4a3e-ae94-2ca0b2b65ce6",
      "span_body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "8cfce58f0ce8de9ee07de1a3123b29e091c5b1917928caf4f6a90dfc79f04c3e"
    },
    {
      "chapter_id": "ch-65f3d8e5-cd07-49bb-a688-31dbdcfe97c0",
      "chapter_number": 7,
      "chapter_title": "潮线之外",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-7f9f05a8-6df4-45d5-9a95-f65db02f050a",
      "span_body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "82d77670ec3f945f5da30dd608e7accd6640a3f09bf103c54114bcf52141e1ff"
    },
    {
      "chapter_id": "ch-c50239fe-72eb-495a-a948-a01c72677cb5",
      "chapter_number": 8,
      "chapter_title": "北堤灯火",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-0341796b-5503-4254-9df5-8acec941fa3f",
      "span_body": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "ab75da7e0d3ec24955927e77a13bcf72efac68cf8d8d7d84922e5f0cbfb6dbcd"
    },
    {
      "chapter_id": "ch-0e492023-7981-40dc-8da0-1419777b9894",
      "chapter_number": 9,
      "chapter_title": "换手",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-36dfc0f8-20b4-4e06-8307-5a9d93cdaa72",
      "span_body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b07ea48fcdc8ed1f76041a0cd9188055ec40adeef4a969b63b212357bef229dd"
    },
    {
      "chapter_id": "ch-e400aa16-5a23-404e-b3b1-268edc43fb19",
      "chapter_number": 10,
      "chapter_title": "回声坐标",
      "chapter_body": "",
      "chapter_revision": 1,
      "span_id": "span-b2df0057-6f4a-4ca1-9619-70fc30cc23a0",
      "span_body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "span_revision": 1,
      "chapter_body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "span_body_sha256": "b3265433a0a1022e4d049a4768879f6763f8db0dbca1c858802e228639ea3e6c"
    }
  ],

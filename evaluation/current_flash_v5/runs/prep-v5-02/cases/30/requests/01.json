    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-e7a9eaec-73a0-432c-81b5-635af69a15c1-r2-1",
      "text": "陈澈说：‘温岚已经把潮汐表交给林默。’",
      "sha256": "01c8159c096f92feba33562657a1769e5c9a21dbf09714c3d4783e6f96f3f2bb"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-e7a9eaec-73a0-432c-81b5-635af69a15c1-r2-2",
      "text": "温岚摇头说：‘我没有交出潮汐表，它仍在我的背包里。’",
      "sha256": "30e952c74e874737b0fd95eb3fb9ffa7222dbf4763f5ef24e853a3903ff97143"
    },
    {
      "kind": "source_span",
      "id": "span-a7f816e6-0313-47ad-9633-4b12056dc842",
      "chapter_id": "ch-fba3ab37-d63a-4bdf-a2b5-e194a2587733",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "source_span",
      "id": "span-3f275e8b-bb38-41a0-ba2a-4fb4d94a9aeb",
      "chapter_id": "ch-4d7f7fd2-e9fc-48fd-b972-ed3d2d4c16fb",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "source_span",
      "id": "span-cdac6d29-19f0-4e6e-b162-791134093a6a",
      "chapter_id": "ch-4b56fb5e-f9d7-4136-9690-c5d09f9348d6",
      "chapter_number": 9,
      "source_revision": 1,
      "text": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "sha256": "c118f3d296dfb8d143c3b0b5467637a24e73f833356f845d5d5c7596956d88a5"
    },
    {
      "kind": "source_span",
      "id": "span-bded0091-13d7-4db0-87d9-4483ac2b88fc",
      "chapter_id": "ch-5dc3fac8-47f4-4601-b967-cf5aed1c7d82",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "memory_record",
      "id": "mem-0587f8b7-c4c7-4ca5-9e75-a6ec25d64b1e",
      "source_span_id": "span-cdac6d29-19f0-4e6e-b162-791134093a6a",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-58d82671-e10c-441e-afd5-010124dda0ee",
      "source_span_id": "span-41348f51-fe6b-4916-aac9-dd4e6ed99cb9",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-efd869f0-37da-4366-8854-60b2d9b25a67",
      "source_span_id": "span-3392a6cd-ab02-4d72-b344-44adc380f42c",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-2f091b22-8ebd-4323-b2da-0956ebfa07be",
      "source_span_id": "span-bded0091-13d7-4db0-87d9-4483ac2b88fc",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-3032c8b2-d7b2-44dd-9e19-77f345a8c542",
      "source_span_id": "span-44a8c10c-977f-45b7-935e-bc0394cc7c4d",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-9bb06bce-9b51-4350-b907-7865723cac3c",
      "source_span_id": "span-3f275e8b-bb38-41a0-ba2a-4fb4d94a9aeb",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-c0cf9634-6990-4f97-8cc3-521c4a288ce8",
      "source_span_id": "span-2c336c25-e507-428c-95c1-da698bf78fa9",
      "text": "雾线水门外锚柱",
      "sha256": "364a41b7ccb226b487b22c1ca8c19df403c7d951678a34979003acf57e4a072e"
    },
    {
      "kind": "memory_record",
      "id": "mem-e4dbcc02-92e6-434b-9854-cd1d525810fb",
      "source_span_id": "span-137e6a7b-c1d9-4704-a661-da8d8355c764",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    }
  ],

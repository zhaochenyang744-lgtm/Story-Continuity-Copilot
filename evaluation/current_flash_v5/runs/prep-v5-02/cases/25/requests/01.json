  "recorded_before_dispatch_at": "2026-09-27T08:04:18.068759+00:00",
  "business_request_sha256": "2946d0a1c8ba1a4e3f33244bdf9d388579ed506ab13f8a431911e9404f9af1e0",
  "bindings": {
    "author_context_snapshot_digest": "4dd96473e0c0674dceb1dd5ccd73902d871d93c8cdab8f45614f64535cd434b0",
    "author_context_version": 0,
    "draft_id": "draft-5fc05667-50b4-44ca-b77e-d8ac4caf2723",
    "draft_revision": 2,
    "memory_version": 4,
    "project_id": "prj-41203c66-97e1-4569-91b2-0edcef224733",
    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-5fc05667-50b4-44ca-b77e-d8ac4caf2723-r2-1",
      "text": "林默走进北门。",
      "sha256": "e4176f286a3ddb9f942263869e400c8c74ea13a68e2dbcbe3ed73505c7823393"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-5fc05667-50b4-44ca-b77e-d8ac4caf2723-r2-2",
      "text": "银钥匙已经交给陈澈。",
      "sha256": "e0a1e5eee3175170025956d235e62111588b69ab9ff2e11e50dba98c31f013d3"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-5fc05667-50b4-44ca-b77e-d8ac4caf2723-r2-3",
      "text": "她此时已经知道弟弟还活着。",
      "sha256": "68c58cfebe353b336151d8195db179a24c5b3b24f38a633a3003dd4cd488ca01"
    },
    {
      "kind": "source_span",
      "id": "span-666bdf0a-e335-47ce-9f66-66039cd33eb2",
      "chapter_id": "ch-2c699f9b-596f-435f-9370-55acfdcf0d68",
      "chapter_number": 4,
      "source_revision": 1,
      "text": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "sha256": "acdbf3c6f280f8ce238bfd95fffc9f29461689cbd936b4002c519c4f303b5657"
    },
    {
      "kind": "source_span",
      "id": "span-2de1e453-29fc-419b-abac-65a64d98a114",
      "chapter_id": "ch-2de89d00-16b9-49ed-a9a8-8dcd84864787",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "source_span",
      "id": "span-a574ffd6-a637-48e7-9379-818a5850bbd7",
      "chapter_id": "ch-58429995-7a08-42ac-ab9c-46b33f03a9a7",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "source_span",
      "id": "span-31400117-70bc-45c4-b12b-d9bc6a2e3569",
      "chapter_id": "ch-52ee5ee3-64d9-49bd-b34d-4871bba7ec69",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "memory_record",
      "id": "mem-9af76053-ec9a-499a-8b9a-219aa917304b",
      "source_span_id": "span-666bdf0a-e335-47ce-9f66-66039cd33eb2",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-0323917f-075b-4e9b-afe9-3cbe236b7478",
      "source_span_id": "span-31400117-70bc-45c4-b12b-d9bc6a2e3569",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-550d323d-24d2-4f60-be8e-45115bb35094",
      "source_span_id": "span-cfb6d36f-1e1d-4a9c-8e03-7d1a0aa80881",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-625f551f-09c6-4777-aa75-4cdc2fd88ae0",
      "source_span_id": "span-8ca7d6fb-ce1a-4c6c-900d-4f378ba9584b",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-8b0bbdb5-350c-4279-a542-293af09d3373",
      "source_span_id": "span-1d05118d-dd0e-463e-b422-ff61d8ec37a7",
      "text": "雾线水门外锚柱",
      "sha256": "364a41b7ccb226b487b22c1ca8c19df403c7d951678a34979003acf57e4a072e"
    },
    {
      "kind": "memory_record",
      "id": "mem-904fae50-6605-41dc-913c-057c8479d563",
      "source_span_id": "span-a574ffd6-a637-48e7-9379-818a5850bbd7",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-f064ca45-6c6c-440a-9c22-1a9b367da5ec",
      "source_span_id": "span-4f190a4e-7f22-41f4-8ca1-7ae2c87e1ff8",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-f72f8484-fdd8-43d5-810f-7dc004680eb4",
      "source_span_id": "span-373c31cf-4b3e-4c99-996e-22de5d545213",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    }
  ],

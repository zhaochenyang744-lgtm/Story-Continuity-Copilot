    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-1612e6af-8b13-4e2a-8da3-0387f3f62a88-r2-1",
      "text": "昨日温岚尚未得知银钥匙的用途。",
      "sha256": "d71edf60ed15d4ff1e5b78fe3436b750ce72618b808cd2b2905357b218561c4f"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-1612e6af-8b13-4e2a-8da3-0387f3f62a88-r2-2",
      "text": "今日她读完陈澈的信，才知道银钥匙能打开潮汐档案柜。",
      "sha256": "41c96c66ec39c27477c97b125f46eae2766e676240244fbe12808e6b265c9829"
    },
    {
      "kind": "source_span",
      "id": "span-dd24833e-8a1b-4a3d-a0f3-16722d35a30e",
      "chapter_id": "ch-53f79fe0-e299-4d78-8502-cc61a9655461",
      "chapter_number": 4,
      "source_revision": 1,
      "text": "温岚看得懂潮表上的坐标，却还不知道‘廊桥钥匙’这个代号指向什么。",
      "sha256": "acdbf3c6f280f8ce238bfd95fffc9f29461689cbd936b4002c519c4f303b5657"
    },
    {
      "kind": "source_span",
      "id": "span-9277438f-86fe-4fb4-827e-95bd6dc9ff02",
      "chapter_id": "ch-aef7995f-1408-42a9-8977-4a5a6130db05",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "source_span",
      "id": "span-daa89a24-48f6-4668-b6df-25b1076efce5",
      "chapter_id": "ch-34fbccb8-ae47-4179-9c44-c5befbb43e76",
      "chapter_number": 9,
      "source_revision": 1,
      "text": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "sha256": "c118f3d296dfb8d143c3b0b5467637a24e73f833356f845d5d5c7596956d88a5"
    },
    {
      "kind": "source_span",
      "id": "span-e48ff43e-57ff-4f9e-945a-9d334226f061",
      "chapter_id": "ch-547bb018-a943-475b-8ae2-ece956ea50b3",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "memory_record",
      "id": "mem-513863b0-ed44-401f-a7ae-a274ce0adb04",
      "source_span_id": "span-dd24833e-8a1b-4a3d-a0f3-16722d35a30e",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-46041f73-3415-452a-830c-a19b79d51606",
      "source_span_id": "span-daa89a24-48f6-4668-b6df-25b1076efce5",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-3b7f0f98-ee29-4a91-a863-05455419d5fb",
      "source_span_id": "span-e7f2f39f-6e17-4a44-89a7-ee4e531f9c0f",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-58183fa9-e7b8-4e6a-85f1-c5f908393e00",
      "source_span_id": "span-b4de061a-c616-45ea-946d-5f734e155201",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",

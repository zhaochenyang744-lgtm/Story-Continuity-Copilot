    },
    {
      "kind": "memory_record",
      "id": "mem-83737522-347e-4090-a504-27b144021b89",
      "source_span_id": "span-9277438f-86fe-4fb4-827e-95bd6dc9ff02",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-98fd5290-4e53-4fbd-ae25-af668c39396a",

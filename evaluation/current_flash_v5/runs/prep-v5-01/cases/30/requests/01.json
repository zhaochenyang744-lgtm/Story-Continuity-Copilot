    "source_revision": 1
  },
  "selected_source_bindings": [
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-39c8c4a7-2537-43a3-9d0b-0f4392a82467-r2-1",
      "text": "陈澈说：‘温岚已经把潮汐表交给林默。’",
      "sha256": "01c8159c096f92feba33562657a1769e5c9a21dbf09714c3d4783e6f96f3f2bb"
    },
    {
      "kind": "draft_claim",
      "id": "draft-claim-draft-39c8c4a7-2537-43a3-9d0b-0f4392a82467-r2-2",
      "text": "温岚摇头说：‘我没有交出潮汐表，它仍在我的背包里。’",
      "sha256": "30e952c74e874737b0fd95eb3fb9ffa7222dbf4763f5ef24e853a3903ff97143"
    },
    {
      "kind": "source_span",
      "id": "span-c4702500-ede0-4a1e-be4f-96b0245051b9",
      "chapter_id": "ch-68a332b3-3c9c-4f6d-94a7-46342321054f",
      "chapter_number": 8,
      "source_revision": 1,
      "text": "温岚把北堤值守簿交给苏岑，两人约定不再各自隐瞒新线索。",
      "sha256": "356f1372376d61df6ed9af380f9c17ca332b58e5d8e09396df79e419eb5fd18a"
    },
    {
      "kind": "source_span",
      "id": "span-1a46b1b6-f1f1-4abc-99c8-f656aa4127b1",
      "chapter_id": "ch-9dd29a31-87e8-4883-9ada-8f4b4874cc37",
      "chapter_number": 10,
      "source_revision": 1,
      "text": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
      "sha256": "183759380df3c5c073ba0256d25ae7426cb03fc193282a5f791b26586f45103b"
    },
    {
      "kind": "source_span",
      "id": "span-81f2bd3c-dc6a-46ca-a413-7b2fd4bfabee",
      "chapter_id": "ch-0c42ca05-fab3-4ab1-a596-a66968e8b280",
      "chapter_number": 9,
      "source_revision": 1,
      "text": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
      "sha256": "c118f3d296dfb8d143c3b0b5467637a24e73f833356f845d5d5c7596956d88a5"
    },
    {
      "kind": "source_span",
      "id": "span-84d98e2f-a447-495b-86de-018fe010f82b",
      "chapter_id": "ch-364d478b-ffcc-4216-a8d9-2ff20cb10ba2",
      "chapter_number": 6,
      "source_revision": 1,
      "text": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
      "sha256": "2d354cc208c312f81f0d4d72c682603571b1edd1bfaf6bcf3561e4e04a22dc6a"
    },
    {
      "kind": "memory_record",
      "id": "mem-0c77e370-096e-4bc6-935a-4994818690b3",
      "source_span_id": "span-81f2bd3c-dc6a-46ca-a413-7b2fd4bfabee",
      "text": "温岚",
      "sha256": "2fdb67447992579f8f9f0c751e36d69fbcaba84c43b2318b010edec750ef1c1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-9f226b46-fd39-4698-94b5-69a61e72e91c",
      "source_span_id": "span-ac1894bd-734c-4355-bc30-55e9b31277af",
      "text": "廊桥钥匙的含义",
      "sha256": "3d99a1a224bc211b22a638a8f187cd974662fc52736efc569d231bb77aa798ff"
    },
    {
      "kind": "memory_record",
      "id": "mem-f3966f45-4549-4dd5-83da-ff6fdcb6f734",
      "source_span_id": "span-b84eb864-dba3-403c-b0b0-97b11dba93f1",
      "text": "没有靠岸，来源未明",
      "sha256": "79fd506cc2927825ff3684e1a00e8fa6f5e8e841cc8d31f5cd4f5f81b1f23b1b"
    },
    {
      "kind": "memory_record",
      "id": "mem-118ef2dc-6c82-40a8-a2e6-7281b56ef772",
      "source_span_id": "span-84d98e2f-a447-495b-86de-018fe010f82b",
      "text": "第6章 21:05 收到三次求救码",
      "sha256": "7556dfa1c21c2596152b98090557914768c4a70b2db0c1c03ce3d6a93349e316"
    },
    {
      "kind": "memory_record",
      "id": "mem-6877c234-c87c-4ce0-a7d9-62b58c05c18f",
      "source_span_id": "span-1a46b1b6-f1f1-4abc-99c8-f656aa4127b1",
      "text": "北潮闸未关闭时响起，原因未解",
      "sha256": "5a1ecc11587f240902b67617d5fcba571f254dc1dff4ddacd9b13321ea989b70"
    },
    {
      "kind": "memory_record",
      "id": "mem-709ad46c-b6ef-48f7-9ee2-cf5e64ef7b9a",
      "source_span_id": "span-b39864e5-f178-4294-a088-e86d939fa8af",
      "text": "第3章 19:20",
      "sha256": "0daa1efb0f5bab6e26354fcc18f5939cfbe755a55b86bc8ea86a6bd5bb5fe3c6"
    },
    {
      "kind": "memory_record",
      "id": "mem-7c279f50-fa5b-4ae1-89f6-151062f6fe37",
      "source_span_id": "span-e9a2467d-0e5f-4f8b-b6d7-fe67f9b929c6",
      "text": "只在北潮闸完全关闭后敲响一次",
      "sha256": "b1d239266968026fc4ef7041f32af6dabaff05fb624ba424e4693ea98dc124b5"
    },
    {
      "kind": "memory_record",
      "id": "mem-c94a8f7c-349b-4dda-9294-ff87bd40a82a",
      "source_span_id": "span-41454bcf-82da-40c4-b430-ed02097389f0",
      "text": "雾线水门外锚柱",
      "sha256": "364a41b7ccb226b487b22c1ca8c19df403c7d951678a34979003acf57e4a072e"
    }
  ],

            ],
            "source_spans": [
              {
                "body": "航图被固定在雾线水门外的锚柱上，右下角缺失了一块。",
                "chapter_id": "ch-5a97b8bf-feb2-4211-8ada-6e0a1bb77de7",
                "chapter_number": 7,
                "chapter_title": "潮线之外",
                "id": "span-eb5f967a-5058-4c64-8a30-c1cb3b94c8bd",
                "label": "地点状态",
                "source_revision": 1
              },
              {
                "body": "电台在二十一点零五分收到三次短促求救码，信号来自雾线水门以外。",
                "chapter_id": "ch-8a961434-506b-4224-9c76-5ac61069bce3",
                "chapter_number": 6,
                "chapter_title": "低室电台",
                "id": "span-0d63ce16-7dec-4723-84ec-b89c4aae2155",
                "label": "事件记录",
                "source_revision": 1
              },
              {
                "body": "北潮闸并未关闭，雾钟却响了一次；温岚仍握着罗盘，港外传来白色渡船的汽笛。",
                "chapter_id": "ch-75bcba2a-e059-4991-a84d-a4382ea50da9",
                "chapter_number": 10,
                "chapter_title": "回声坐标",
                "id": "span-f1b0ce45-79c7-4514-977a-1117a5b7ba99",
                "label": "未解问题",
                "source_revision": 1
              },
              {
                "body": "进入仓道前，苏岑把带月牙裂纹的黄铜罗盘交到温岚手里保管。",
                "chapter_id": "ch-0d1b0854-ea83-4a89-8648-bee4d5401835",
                "chapter_number": 9,
                "chapter_title": "换手",
                "id": "span-8d7151af-ae73-4835-9953-04413edca86f",
                "label": "动态状态",
                "source_revision": 1
              }
            ]
          }
